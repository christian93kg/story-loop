# Obsidian app state — machine-specific, not part of the kit
.obsidian/

# Draft scratch space — see CLAUDE.md play hygiene. Beats are drafted here and
# linted before they reach a chapter log; the drafts themselves are disposable.
**/scratchpad/
# ...but the template's copy must ship, so every scaffolded story gets the
# directory for free. Git will not descend into an excluded directory, so the
# directory itself has to be un-excluded before the file inside it can be.
!_template/scratchpad/
!_template/scratchpad/.gitkeep

# Local permission overrides — personal, not shipped
.claude/settings.local.json

# Claude Code runtime lock files
.claude/scheduled_tasks.lock

.DS_Store

# Python bytecode
__pycache__/
*.pyc

# The beat ledger — per-session chain of custody, not part of the kit. Already covered
# by **/scratchpad/; listed explicitly so a relocated scratchpad still excludes it.
**/.beat_ledger.json

# The retired root-level scratch dir. Drafts, briefs, verdicts and the ledger all live
# at <story>/scratchpad/, which is inside the story tree (so state survives /clear).
/_scratch/

# Shelved / finished stories
/_archive/

# Your story folders are NOT ignored — in your own repo your story is the point.
# But never develop this kit inside a tree that also holds a private story you do not
# intend to publish: `git add -A` would commit all of it. Develop in a clean clone and
# copy the kit files into your vault.
